<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Left Section: Battery & Temperature -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌡️ --°C"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Vertical Divider -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#22FFFFFF"
        android:layout_marginHorizontal="12dp" />

    <!-- Right Section: Safety Status & Health -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ BATTERY SAFETY"
            android:textColor="#90A4AE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Dynamic Safety Status -->
        <TextView
            android:id="@+id/widget_safety_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Safe"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Health -->
        <TextView
            android:id="@+id/widget_health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️ Health: Good"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- Magnetic Safety Status -->
        <TextView
            android:id="@+id/widget_magnetic_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧲 Mag: Safe"
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
